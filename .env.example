# === 必填 ===
TARGET_GROUP_IDS=       # 群号，逗号分隔
                        # 格式: groupId[:sendMode[:schedule]]
                        # sendMode: group(发群里) | 默认发私聊
                        # schedule: daily(每天17:30总结前日) | 默认每天3次
                        # 例: 123,456:group,789:group:daily
GEMINI_API_KEY=         # Google Gemini API Key

# === 可选（均有默认值，通常不需要改） ===
# ONEBOT_HTTP_URL=http://127.0.0.1:3000   # NapCat HTTP 地址
# ONEBOT_TOKEN=                            # NapCat AccessToken（如有设置）
# BOT_QQ=                                  # 留空自动获取机器人QQ
# GEMINI_MODEL=gemini-3-flash-preview      # Gemini 模型
# LLM_API_KEY=                             # 备用LLM (DeepSeek) API Key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
